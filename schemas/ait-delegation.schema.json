{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/depwire/ait-spec/schemas/ait-delegation.schema.json",
  "title": "AIT-D Delegation Token Payload",
  "description": "Agent Identity Token — Delegation Token (AIT-D). Issued when a parent agent spawns a child agent.",
  "type": "object",
  "required": ["ait", "jti", "iss", "iat", "exp", "parent_session_ref", "parent_agent_id", "child_agent_id", "delegated_scope"],
  "properties": {
    "ait": { "type": "string", "const": "0.1" },
    "jti": { "type": "string", "format": "uuid" },
    "iss": { "type": "string" },
    "iat": { "type": "integer" },
    "exp": { "type": "integer", "description": "Max 86400s from iat for delegation tokens" },
    "parent_session_ref": { "type": "string", "format": "uuid" },
    "parent_agent_id": { "type": "string", "format": "uuid" },
    "child_agent_id": { "type": "string", "format": "uuid" },
    "child_model": { "type": "string" },
    "child_model_provider": { "type": "string" },
    "delegated_scope": {
      "type": "object",
      "required": ["read", "write", "execute"],
      "description": "MUST be strict subset of parent scope",
      "properties": {
        "read": { "type": "array", "items": { "type": "string" } },
        "write": { "type": "array", "items": { "type": "string" } },
        "execute": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      }
    },
    "delegation_reason": { "type": "string" }
  }
}
