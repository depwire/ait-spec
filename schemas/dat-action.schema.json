{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/depwire/dat-spec/schemas/dat-action.schema.json",
  "title": "DAT-A Action Token Payload",
  "description": "Depwire Action Token — Action Token (DAT-A). Issued per atomic agent action.",
  "type": "object",
  "required": ["dat", "jti", "iss", "iat", "exp", "session_ref", "agent_id", "action"],
  "properties": {
    "dat": { "type": "string", "const": "0.1" },
    "jti": { "type": "string", "format": "uuid" },
    "iss": { "type": "string" },
    "iat": { "type": "integer" },
    "exp": { "type": "integer", "description": "Max 300s from iat for action tokens" },
    "session_ref": { "type": "string", "format": "uuid", "description": "jti of parent DAT-S or DAT-D" },
    "agent_id": { "type": "string", "format": "uuid", "description": "Must match agent_id in referenced session" },
    "action": {
      "type": "object",
      "required": ["type", "tool", "target"],
      "properties": {
        "type": { "type": "string", "enum": ["file_read", "file_write", "tool_call", "command_execute", "agent_spawn", "agent_terminate"] },
        "tool": { "type": "string" },
        "target": { "type": "string" },
        "params": { "type": "object" }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "hash": { "type": "string", "description": "SHA-256 of active context window" },
        "files_in_context": { "type": "array", "items": { "type": "string" } },
        "token_count": { "type": "integer" }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "prev_hash": { "type": "string", "description": "SHA-256 of file before action" },
        "post_hash": { "type": "string", "description": "SHA-256 of file after action" }
      }
    }
  }
}
