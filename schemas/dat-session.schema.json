{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/depwire/dat-spec/schemas/dat-session.schema.json",
  "title": "DAT-S Session Token Payload",
  "description": "Depwire Action Token — Session Token (DAT-S). Issued when an agent session begins.",
  "type": "object",
  "required": ["dat", "jti", "iss", "iat", "exp", "agent_id", "model", "model_provider", "scope"],
  "properties": {
    "dat": { "type": "string", "const": "0.1", "description": "DAT spec version" },
    "jti": { "type": "string", "format": "uuid", "description": "Unique token ID (UUID v4)" },
    "iss": { "type": "string", "description": "Issuer identifier (e.g. depwire-cli@1.1.8)" },
    "iat": { "type": "integer", "description": "Issued at (Unix timestamp)" },
    "exp": { "type": "integer", "description": "Expiry (Unix timestamp). Max 3600s from iat." },
    "agent_id": { "type": "string", "format": "uuid", "description": "Unique agent identifier (UUID v4)" },
    "model": { "type": "string", "description": "Model identifier (e.g. claude-sonnet-4-20250514)" },
    "model_provider": { "type": "string", "description": "Model provider (e.g. anthropic, openai, google)" },
    "human_ref": { "type": "string", "description": "SHA-256 hash of human authorization event (optional)" },
    "scope": {
      "type": "object",
      "required": ["read", "write", "execute"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns for readable paths" },
        "write": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns for writable paths" },
        "execute": { "type": "array", "items": { "type": "string" }, "description": "Allowed executables" },
        "deny": { "type": "array", "items": { "type": "string" }, "description": "Explicit deny patterns (overrides all)" }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "repo": { "type": "string" },
        "commit": { "type": "string" },
        "branch": { "type": "string" }
      }
    }
  }
}
